# Uploaded video/thumbnail files live under here. Never let this
# directory execute code, no matter what slips past upload validation.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php\d?|pl|py|cgi|sh|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes -ExecCGI
